# Replit configuration. Development happens on GitHub; Replit only mirrors this repo.
run = "npm install && npm run dev"
modules = ["nodejs-22"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
# Static hosting: the whole arcade runs in the browser, no server needed.
deploymentTarget = "static"
build = ["sh", "-c", "npm ci && npm run build"]
publicDir = "dist"
